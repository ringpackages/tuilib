# Event types (TUIEvent.cType)
TUI_EVENT_KEYBOARD = "keyboard"
TUI_EVENT_MOUSE    = "mouse"

# Menu item types (TUIMenuItem.cItemType)
TUI_MENUITEM_NORMAL    = "normal"
TUI_MENUITEM_CHECKBOX  = "checkbox"
TUI_MENUITEM_SEPARATOR = "separator"
TUI_MENUITEM_SUBMENU   = "submenu"

# Mouse actions (TUIEvent.nAction)
TUI_MOUSE_PRESS     = 1
TUI_MOUSE_RELEASE   = 2
TUI_MOUSE_MOVE      = 3
TUI_MOUSE_DRAG      = 4		# Move with a button down
TUI_MOUSE_WHEELUP   = 5
TUI_MOUSE_WHEELDOWN = 6

# Mouse buttons (TUIEvent.nButton)
TUI_BUTTON_NONE   = 0
TUI_BUTTON_LEFT   = 1
TUI_BUTTON_RIGHT  = 2
TUI_BUTTON_MIDDLE = 3

# Keys that are not RogueUtil constants
TUI_KEY_BACKSPACE = 8
TUI_KEY_TAB       = 9
