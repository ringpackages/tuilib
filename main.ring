func main
	C_LINESIZE = 80
	? copy("=",C_LINESIZE)
	? "TUILib Package"
	? copy("=",C_LINESIZE)
	? "TUILib package (Terminal User Interface widgets using RogueUtil) for the Ring programming language"
	? "See the folder : ring/libraries/tuilib"
	? "Samples        : ring/samples/UsingTUILib"
	? copy("=",C_LINESIZE)
